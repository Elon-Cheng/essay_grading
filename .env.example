SITE_DOMAIN=essay.example.com
PUBLIC_BASE_URL=https://essay.example.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://www.su8.codes/v1
OPENAI_MODEL=gpt-5.5

# SaaS: leave price empty until ready to sell. Amount is in fen (integer).
APP_ENV=development
INLINE_WORKER=1
# Separate worker only: maximum essays graded at the same time (1-8).
WORKER_CONCURRENCY=1
DATABASE_URL=
POSTGRES_PASSWORD=
FREE_DAILY_QUOTA=1
USER_MAX_PENDING=2
PRO_PRICE_FEN=
TEACHER_PRICE_FEN=
# manual: personal collection codes + administrator review. Price and images are
# configured in /admin -> personal collections. No merchant credentials required.
PAYMENTS_MODE=manual
ESSAY_MAX_CHARS=20000
AI_MAX_PROMPT_CHARS=100000
AI_MAX_OUTPUT_TOKENS=12000
# Total completed generation attempts per channel, including format repairs (2–4).
AI_FORMAT_ATTEMPTS=3
# JSON is always validated locally. auto requests strict API JSON Schema and
# falls back only on an explicit HTTP 400 unsupported-format rejection.
# 1 requires native schema support; 0 uses the JSON prompt + local validation.
AI_STRUCTURED_OUTPUT=auto
AI_TIMEOUT_SECONDS=120
# AI_STREAM=1 after verifying the provider's Responses SSE compatibility.
AI_STREAM=0
AI_CONNECT_TIMEOUT_SECONDS=10
AI_TOTAL_TIMEOUT_SECONDS=600
AI_MAX_RESPONSE_BYTES=2000000
AI_TRUST_ENV=1
# Optional HTTP CONNECT proxy for AI requests only (e.g. http://127.0.0.1:1080).
# Overrides AI_TRUST_ENV and NO_PROXY; leave empty to keep the existing route.
AI_PROXY_URL=
AI_REASONING_EFFORT=
AI_PRICE_CURRENCY=CNY
AI_PRICE_VERSION=
AI_INPUT_PRICE_PER_MILLION=
AI_CACHED_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_DAILY_BUDGET=
AI_CALL_BUDGET_RESERVATION=1

# Keep key files outside the repo. WeChat public key mode; rotate ID and PEM together.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Paypro advanced: enable after verifying actual settlement.
PAYPRO_BASE_URL=
PAYPRO_SECRET=
PAYPRO_WECHAT_ENABLED=0
PAYPRO_ALIPAY_ENABLED=0
PAYPRO_SETTLEMENT_VERIFIED=0
